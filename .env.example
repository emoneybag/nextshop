# Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nextshop"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Stripe (test mode): https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# For local dev run: stripe listen --forward-to localhost:3000/api/stripe/webhook
# It prints a signing secret (whsec_...) to paste here.
STRIPE_WEBHOOK_SECRET=""

# Comma-separated emails that become admins when they sign in (see /admin)
ADMIN_EMAILS=""

# Order emails via Resend (https://resend.com). Leave empty in development:
# emails are printed to the terminal instead of being sent.
RESEND_API_KEY=""
# Must be a domain you verified in Resend (onboarding@resend.dev works for testing to your own address)
EMAIL_FROM="NextShop <onboarding@resend.dev>"
