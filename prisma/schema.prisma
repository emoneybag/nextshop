// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())

  username     String   @unique
  email        String   @unique
  passwordHash String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role         UserRole @default(USER)

  orders       Order[]
  wishlist     WishlistItem[]
  reviews      Review[]
}


model Product {
  id             Int      @id @default(autoincrement())

  name           String
  tagline        String
  description    String
  /// Prices are stored in cents to avoid floating-point money bugs.
  priceCents     Int
  compareAtCents Int?
  category       String
  image          String
  rating         Float
  reviews        Int      @default(0)
  badge          String?
  features       String[]
  /// Array of { label, value } pairs.
  specs          Json
  /// Soft-delete flag: inactive products are hidden but keep order history intact.
  active         Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]
  userReviews    Review[]

  @@index([category])
}

enum OrderStatus {
  /// Created at checkout, waiting for Stripe to confirm payment.
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id            String      @id @default(cuid())
  /// Short, human-friendly reference, e.g. NS-4F9K2Q
  reference     String      @unique
  /// No default on purpose: code must choose PENDING (unpaid) or CONFIRMED (paid).
  status        OrderStatus

  email         String
  subtotalCents Int
  shippingCents Int
  taxCents      Int
  totalCents    Int
  /// Snapshot of the discount applied at checkout (code kept even if the code is later deleted).
  discountCode  String?
  discountCents Int         @default(0)

  shipName       String
  shipAddress    String
  shipCity       String
  shipRegion     String
  shipPostalCode String
  shipCountry    String

  stripeSessionId       String?  @unique
  stripePaymentIntentId String?
  paidAt                DateTime?

  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  items         OrderItem[]

  createdAt     DateTime    @default(now())

  @@index([userId, createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())

  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Nullable so a product can be removed later without losing order history.
  productId  Int?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Snapshot of the product at purchase time.
  name       String
  image      String
  priceCents Int
  quantity   Int

  @@index([orderId])
}


model WishlistItem {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

model Review {
  id        String   @id @default(cuid())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 1–5
  rating    Int
  title     String
  body      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One review per customer per product (re-submitting edits it).
  @@unique([productId, userId])
  @@index([productId, createdAt])
}

enum DiscountType {
  PERCENT
  FIXED
}

model DiscountCode {
  id               String       @id @default(cuid())
  /// Always stored upper-case.
  code             String       @unique
  type             DiscountType
  /// Percent (1–100) for PERCENT, cents for FIXED.
  value            Int
  minSubtotalCents Int          @default(0)
  maxRedemptions   Int?
  redeemedCount    Int          @default(0)
  expiresAt        DateTime?
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
}
